FLUXIUM_ENVIRONMENT=local
FLUXIUM_API_PREFIX=/api/v1
FLUXIUM_MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
FLUXIUM_MONGO_DATABASE=fluxium
FLUXIUM_REDIS_URL=redis://:redis1234@localhost:6379/0
FLUXIUM_OLLAMA_BASE_URL=http://localhost:11434
FLUXIUM_OLLAMA_MODEL=
# Single workspace used by a tenant when identities do not carry workspace_ids.
FLUXIUM_DEFAULT_WORKSPACE_ID=
# Required for the internal OIDC provider. Use a random secret of at least 32 bytes.
FLUXIUM_IDENTITY_JWT_SECRET=
FLUXIUM_IDENTITY_JWT_ALGORITHM=HS256
# Required only for RS256. PEM values may use literal \n line breaks.
FLUXIUM_IDENTITY_JWT_PRIVATE_KEY=
FLUXIUM_IDENTITY_JWT_PUBLIC_KEY=
FLUXIUM_IDENTITY_JWT_KEY_ID=fluxium-internal
FLUXIUM_IDENTITY_JWT_ISSUER=http://localhost:8000
FLUXIUM_IDENTITY_JWT_AUDIENCE=fluxium-api
FLUXIUM_IDENTITY_ACCESS_TOKEN_TTL_SECONDS=7200
FLUXIUM_IDENTITY_REFRESH_TOKEN_TTL_SECONDS=0
# Set to 1 only when running MongoDB integration tests locally.
FLUXIUM_RUN_MONGO_INTEGRATION=0
# Set to 1 only when running Redis-backed Readiness worker integration tests.
# The tests use the configured Redis URL and a fake AI provider; Ollama is not required.
FLUXIUM_RUN_REDIS_INTEGRATION=0
# Maximum time, in seconds, for the opt-in Redis worker integration polling loop.
FLUXIUM_REDIS_INTEGRATION_TIMEOUT_SECONDS=5
